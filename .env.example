# ─────────────────────────────────────────────────────────────
# Free Stars ✨ — пример конфигурации. Скопируйте в .env и заполните.
# НИКОГДА не коммитьте .env в репозиторий.
# ─────────────────────────────────────────────────────────────

# Токен бота от @BotFather. Обязателен для платежей и уведомлений.
BOT_TOKEN=1234567890:REPLACE_ME_with_real_bot_token

# Имя пользователя бота без @ (узнать: node tools/owner-id.mjs или getMe).
BOT_USERNAME=

# Название приложения — заголовки Mini App и тексты.
APP_NAME=Free Stars

# ── Владелец ─────────────────────────────────────────────────
# Числовые Telegram ID через запятую. Только у них есть админ-панель.
# Узнать свой ID: напишите боту /start и запустите `npm run owner:id`
OWNER_TELEGRAM_IDS=777000111
OWNER_USERNAME=maxxm4z

# Ссылка на группу — кнопка «Группа» в сообщении /start.
GROUP_URL=https://t.me/maksimruml

# ── Приложение ───────────────────────────────────────────────
# Публичный HTTPS-адрес, где доступен Mini App (для локальной проверки
# можно использовать туннель, например cloudflared/ngrok).
PUBLIC_URL=https://example.com
PORT=3001
HOST=0.0.0.0

# ── База данных ──────────────────────────────────────────────
DB_PATH=data/freestars.db

# ── Игровая логика ───────────────────────────────────────────
# Цена дополнительного спина в Telegram Stars.
SPIN_PRICE_STARS=5
# На какой день серии выдаётся гарантированный подарок.
GUARANTEE_DAYS=31
# Каждые N дней серии игрок получает дополнительный бесплатный спин. 0 = выключить.
SERIES_BONUS_EVERY=5
# Смещение часового пояса сервера (часы) для определения «серверного дня».
# 0 = UTC, 3 = Москва, -5 = Нью-Йорк.
SERVER_TZ_OFFSET_HOURS=0
# Максимальный возраст initData в секундах.
INITDATA_MAX_AGE_SECONDS=86400

# ── Внутренняя оценка себестоимости подарков (НЕ официальные цены) ──
COST_BEAR_STARS=15
COST_HEART_STARS=15
COST_CAKE_STARS=50

# ── Контроль финансового риска ───────────────────────────────
BUDGET_WARNING_STARS=500
BUDGET_CRITICAL_STARS=200

# ── Реальная выдача Telegram Gifts (опционально) ─────────────
# Telegram отдаёт боту только подарки из своего официального каталога
# (getAvailableGifts / sendGift). Подарки Free Stars — авторские картинки,
# поэтому по умолчанию выдача идёт вручную через владельца.
# Если владелец сопоставил подарок с реальным gift_id из каталога,
# можно включить автоматическую отправку:
# TG_GIFT_BEAR_ID=
# TG_GIFT_HEART_ID=
# TG_GIFT_CAKE_ID=
# AUTO_ISSUE_GIFTS=0

# ── Webhook (для приёма платежей) ────────────────────────────
# Без WEBHOOK_URL сервер сам использует long polling (удобно локально).
# WEBHOOK_URL=https://example.com
# WEBHOOK_SECRET=change_me

# Отключить long polling полностью (например в тестах): DISABLE_UPDATE_PUMP=1